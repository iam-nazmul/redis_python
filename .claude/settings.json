{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git show*)",
      "Bash(uv run *)",
      "Bash(uv sync*)",
      "Bash(uv lock*)",
      "Bash(uv tree*)",
      "Bash(python main.py)",
      "Bash(python -u main.py)",
      "Bash(python -m py_compile *)",
      "Bash(python -m pytest*)",
      "Bash(pytest*)",
      "Bash(redis-cli *)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Bash(rm -rf *)"
    ]
  }
}
